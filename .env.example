# Versioned release image pulled by Docker Compose.
DASHBOARD_IMAGE=ghcr.io/singhangadin/dgx-spark-dashboard
DASHBOARD_VERSION=latest
# Addresses the dashboard binds to (comma/space-separated). Each entry is a
# literal IP or an interface name; loopback is always bound in addition. The app
# has no authentication, so prefer specific trusted interfaces over 0.0.0.0 —
# e.g. "wg0,tailscale0" to serve WireGuard and Tailscale but no other NIC.
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8787
# Filled by install.sh from /var/run/docker.sock. Required for Docker metrics.
DOCKER_GID=999
