# Versioned release image pulled by Docker Compose.
DASHBOARD_IMAGE=ghcr.io/singhangadin/dgx-spark-dashboard
DASHBOARD_VERSION=latest
# Host address the dashboard binds to. With host networking this is a real host
# interface, and the app has no authentication, so avoid 0.0.0.0 on untrusted
# networks. Default to loopback; set a specific interface (e.g. a WireGuard or
# LAN address like 10.0.0.2) to reach it remotely without exposing every NIC.
DASHBOARD_BIND_ADDRESS=127.0.0.1
DASHBOARD_PORT=8787
# Filled by install.sh from /var/run/docker.sock. Required for Docker metrics.
DOCKER_GID=999
